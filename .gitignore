# ===============================
# 1. ВИРТУАЛЬНЫЕ ОКРУЖЕНИЯ
# ===============================
# Самое важное: не тащить в репозиторий тяжелые папки с библиотеками
venv/
env/
.venv/
.env/
virtualenv/
pyenv/
.venv.local/
.env.local/

# ===============================
# 2. БАЙТ-КОД И КЕШ PYTHON
# ===============================
# Python компилирует .py в .pyc (байт-код) — это мусор, который регенерируется
__pycache__/
*.py[cod]
*$py.class

# Файлы, создаваемые setuptools/distutils
*.so
*.egg-info/
dist/
build/
*.egg

# Кеш mypy, pytest и других тулзов
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
.coverage
.coverage.*
htmlcov/

# ===============================
# 3. ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ И СЕКРЕТЫ
# ===============================
# Никогда, НИКОГДА не коммитим .env в репозиторий!
.env
.env.production
.env.local
.env.*.local

# Файлы с паролями, токенами, ключами шифрования
*.pem
*.key
*.crt
*.p12
secrets.yaml
config/credentials.yml

# ===============================
# 4. ЛОГИ И ВРЕМЕННЫЕ ФАЙЛЫ
# ===============================
*.log
*.pid
*.seed
*.pid.lock
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal

# Временные файлы редакторов
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===============================
# 5. ФРЕЙМВОРКИ (Django / Flask / FastAPI)
# ===============================
# Django
*.sqlite3
media/
staticfiles/
static/
uploads/

# Flask (устаревший способ хранения сессий)
flask_session/

# ===============================
# 6. JUPYTER NOTEBOOKS (если используешь)
# ===============================
# Выхлопы ноутбуков (лучше их не коммитить, либо коммитить очищенными)
.ipynb_checkpoints/
*.ipynb
.pynb_checkpoints/

# ===============================
# 7. ПАКЕТНЫЙ МЕНЕДЖЕР (Poetry / Pipenv / PDM)
# ===============================
# Для Poetry — если используешь, лучше коммитить poetry.lock, но не папку .venv
poetry.lock  # (ЗАКОММЕНТИРУЙ ЭТУ СТРОКУ, если хочешь хранить lock файл)
# .venv/      # (уже было выше)

# Для Pipenv
Pipfile.lock  # (обычно хранят, но папку вирт. окружения — нет)

# ===============================
# 8. ПРОФАЙЛИНГ И ОТЧЕТЫ
# ===============================
profile_results/
*.prof
*.snap
benchmark/
reports/

# ===============================
# 9. РАЗНОЕ (IDE)
# ===============================
# PyCharm
.idea/
*.iml

# VSCode
.vscode/
*.code-workspace

# Sublime
*.sublime-workspace
*.sublime-project